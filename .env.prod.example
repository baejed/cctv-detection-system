# EyeGila — Production Environment
# Copy this file to .env.prod and fill in every value before first run.
# Generate secrets with: python scripts/generate_secrets.py >> .env.prod

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME          # strong random password
DATABASE_URL=postgresql://postgres:CHANGE_ME@pgbouncer:5432/traffic

# ── Security ──────────────────────────────────────────────────────────────────
SUPER_KEY=CHANGE_ME                  # guards the /users/ admin API
FERNET_KEY=CHANGE_ME                 # encrypts camera RTSP credentials at rest

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Set to the actual domain or IP address of this server.
CORS_ORIGINS=http://localhost,http://YOUR_SERVER_IP
TZ=Asia/Manila
TRUST_PROXY_HEADERS=true
SESSION_TTL_HOURS=8

# ── Automatic analysis ───────────────────────────────────────────────────────
# How often (in minutes) to automatically rerun warrant analysis + timing for all
# intersections. Set to 0 to disable and use manual Regenerate only.
ANALYSIS_INTERVAL_MINUTES=60

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500

# ── Worker (camera inference) ─────────────────────────────────────────────────
CAMERAS_PER_WORKER=16               # GPU workers: how many cameras per process
INFERENCE_EVERY_N=1                 # run inference on every N-th frame (raise to reduce load)
READER_MAX_FPS=0                    # 0 = unlimited; cap if cameras send too many frames

# ── Push notifications (optional) ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── PgBouncer pool ────────────────────────────────────────────────────────────
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
