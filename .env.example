# ── Database ────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_NAME=eyegila
DB_USER=eyegila
DB_PASSWORD=change_me

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Manila

# ── Workers ──────────────────────────────────────────────────────────────────
# One worker pod per camera. Set this to the max number of cameras you expect.
WORKER_REPLICAS=5

# ── Super key ────────────────────────────────────────────────────────────────
# Required to create/manage users via POST /users/.
# Set to any long random string. Example: openssl rand -hex 32
SUPER_KEY=change_me_superkey

# ── Push notifications (optional) ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
