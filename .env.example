# Copy this file to .env and fill in the values before running docker compose.

# ── VAPID push notification keys ─────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Admin API key — any strong random string
SUPER_KEY=

# Fernet key for encrypting RTSP URLs at rest. Leave blank to skip encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=24

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API.
# In production set this to your actual frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Manila

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Set to true if running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── Worker (GPU / production) ─────────────────────────────────────────────────
# How many cameras each worker process handles simultaneously.
CAMERAS_PER_WORKER=16

# Run inference on every Nth frame (1 = every frame).
INFERENCE_EVERY_N=1

# Cap the frame-reader rate (frames/sec). 0 = unlimited.
READER_MAX_FPS=0

# ── Mac / CPU-only development ────────────────────────────────────────────────
# On a MacBook (or any machine without an NVIDIA GPU) use:
#
#   make dev-mac
#
# That single command starts the full stack using CPU workers. Under the hood:
#
#   1. Uses rq-worker/Dockerfile.mac (onnxruntime CPU; no TensorRT)
#   2. Activates --profile worker   (CPU live-camera worker)
#   3. Model is mounted from ./<MODEL_VERSION>.pt → /app/model.pt at runtime
#      (not baked into the image, so version changes don't need a rebuild)
#
# Recommended .env overrides for Mac to avoid saturating the CPU:
#
# CAMERAS_PER_WORKER=1
# INFERENCE_EVERY_N=5    # write to DB every 5th detected frame
# READER_MAX_FPS=10      # cap stream reader at 10 fps

# Model version — must match the .pt file in the project root.
MODEL_VERSION=eyegila_v4
