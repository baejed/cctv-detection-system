# syntax=docker/dockerfile:1
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY worker/requirements.mac.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt
COPY common ./common
COPY worker ./worker
# Model weights are NOT baked into this image.
# docker-compose mounts ./${MODEL_VERSION}.pt at /app/model.pt at runtime,
# so the image stays version-agnostic and rebuilds are not needed when
# weights are updated.

CMD ["python", "-m", "worker.main"]
